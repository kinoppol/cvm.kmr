<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{$appName} · รายวิชาที่เปิดสอน</title>
    <meta name="description" content="รายวิชาที่เปิดสอนใน{$college}">
    <link rel="stylesheet" href="{$base}/assets/css/landing.css">
</head>
<body>
<div class="lp">
    <header class="lp-header">
        <div class="lp-wrap">
            <a href="{$base}/" class="lp-logo">
                <span class="lp-logo-mark">RV</span>
                <span class="lp-logo-name">{$appName}</span>
            </a>
            <nav class="lp-nav">
                <a href="#courses">รายวิชา</a>
                <a href="{$base}/login" class="lp-btn lp-btn-sm">เข้าสู่ระบบ</a>
            </nav>
        </div>
    </header>

    <section class="lp-hero">
        <div class="lp-wrap">
            <div class="lp-eyebrow">{$college}</div>
            <h1>รายวิชาที่เปิดสอน</h1>
            <div class="lp-crumb"><a href="{$base}/">หน้าแรก</a> &nbsp;/&nbsp; รายวิชา</div>
            <p class="lp-hero-lead">
                {if $term}{$term} · {/if}รวม {$courseCount} รายวิชาที่ครูผู้สอนเลือกเปิดเผยข้อมูลสู่สาธารณะ
                เข้าสู่ระบบเพื่อดูบทเรียนและแบบทดสอบทั้งหมด
            </p>
        </div>
    </section>

    <main class="lp-body-area" id="courses">
        <div class="lp-wrap">
            <div class="lp-section-title">
                <h2>รายวิชาของเรา</h2>
                <p>จัดกลุ่มตามสาขาวิชา</p>
            </div>

            {if $groups}
                {foreach $groups as $g}
                    <section class="lp-group">
                        <div class="lp-group-head">
                            <h3>{$g['department']}</h3>
                            <span>{count($g['courses'])} รายวิชา</span>
                        </div>
                        <div class="lp-grid">
                            {foreach $g['courses'] as $c}
                                <article class="lp-card">
                                    <div class="lp-card-img" style="background:#{$c['color']}">
                                        <span class="lp-code">{$c['code']}</span>
                                        <span class="lp-credit">{(float) $c['credits']} นก.</span>
                                    </div>
                                    <div class="lp-card-body">
                                        <div class="lp-card-cat">{$c['classroom_name'] ?? 'ไม่ระบุกลุ่มเรียน'}</div>
                                        <h4>{$c['name']}</h4>
                                        {if $c['description']}
                                            <p class="lp-card-desc">{$c['description']}</p>
                                        {/if}
                                        <div class="lp-card-foot">
                                            <span class="lp-card-meta">
                                                {if $c['teacher_name']}{$c['teacher_name']}{else}—{/if}<br>
                                                ทฤษฎี {$c['theory_hours']} / ปฏิบัติ {$c['practice_hours']} ชม.
                                            </span>
                                            <a class="lp-more" href="{$base}/login">ดูรายละเอียด</a>
                                        </div>
                                    </div>
                                </article>
                            {/foreach}
                        </div>
                    </section>
                {/foreach}
            {else}
                <div class="lp-empty">
                    <h3>ยังไม่มีรายวิชาที่เปิดเผยสู่สาธารณะ</h3>
                    <p>ครูผู้สอนสามารถเปิดการแสดงรายวิชาได้จากเมนู “รายวิชาของฉัน” หลังเข้าสู่ระบบ</p>
                </div>
            {/if}
        </div>
    </main>

    <footer class="lp-footer">
        <div class="lp-wrap">
            <div class="lp-footer-col">
                <h4>{$appName}</h4>
                <p>ระบบจัดการเรียนรู้พร้อมผู้ช่วย AI สำหรับครูและนักเรียน{$college}</p>
            </div>
            <div class="lp-footer-col">
                <h4>เมนู</h4>
                <p><a href="#courses">รายวิชาที่เปิดสอน</a><br><a href="{$base}/login">เข้าสู่ระบบ</a></p>
            </div>
            <div class="lp-footer-col">
                <h4>ติดต่อ</h4>
                <p>{$college}</p>
            </div>
        </div>
        <div class="lp-footer-bottom">
            Copyright &copy; <script>document.write(new Date().getFullYear());</script>
            &nbsp;·&nbsp; ดีไซน์อ้างอิงจากแม่แบบที่จัดทำโดย <a href="https://colorlib.com" target="_blank" rel="noopener">Colorlib</a>
        </div>
    </footer>
</div>
</body>
</html>
