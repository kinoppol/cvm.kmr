{layout '../layout.latte'}

{block title}รายวิชาของฉัน{/block}

{block content}
<div class="dash">
    <div class="courses-head">
        <div class="grow">
            <div class="dash-greeting">รายวิชาของฉัน</div>
            <div class="dash-sub">{$term ?? ''} · {count($courses)} รายวิชา</div>
        </div>
        <a class="btn btn-primary" href="{$base}/courses/new">+ เพิ่มรายวิชา</a>
    </div>

    {if $courses}
        <form method="post" action="{$base}/courses/landing-visibility" class="landing-toggle">
            <input type="hidden" name="_token" value="{$csrf}">
            <input type="hidden" name="visible" value="{$landingVisible ? '0' : '1'}">
            <div class="landing-toggle-text">
                <div class="landing-toggle-title">แสดงรายวิชาของฉันในหน้าแรกสาธารณะ</div>
                <div class="landing-toggle-sub">
                    {if $landingVisible}
                        ผู้ที่ยังไม่เข้าสู่ระบบเห็นรหัสวิชา ชื่อวิชา และคำอธิบายของทุกวิชาที่คุณสอน
                    {else}
                        ค่าเริ่มต้นคือไม่แสดง — เปิดเมื่อต้องการประชาสัมพันธ์รายวิชาให้บุคคลภายนอก
                    {/if}
                </div>
            </div>
            <button type="submit" n:class="switch, $landingVisible ? is-on" aria-label="สลับการแสดงในหน้าแรก">
                <span class="switch-dot"></span>
            </button>
        </form>
    {/if}

    {if $courses}
        <div class="course-grid">
            {foreach $courses as $c}
                <a class="course-card" href="{$base}/courses/{$c['id']}">
                    <div class="course-card-head" style="background:#{$c['color']}">
                        <div class="code">{$c['code']}</div>
                        <div class="name">{$c['name']}</div>
                    </div>
                    <div class="course-card-body">
                        <div class="meta">{$c['classroom_name'] ?? 'ยังไม่ระบุกลุ่มเรียน'} · {$c['student_count']} คน</div>
                        <div class="note">{$c['lesson_count']} บทเรียน · แบบทดสอบ {$c['quiz_count']} ชุด</div>
                    </div>
                </a>
            {/foreach}
        </div>
    {else}
        <div class="empty" style="margin-top:26px">
            <h3>ยังไม่มีรายวิชาที่สอนในภาคเรียนนี้</h3>
            <p>กดปุ่ม “เพิ่มรายวิชา” ด้านบนเพื่อสร้างรายวิชาแรกของคุณ</p>
            <a class="btn btn-primary" href="{$base}/courses/new" style="margin-top:14px">+ เพิ่มรายวิชา</a>
        </div>
    {/if}
</div>
{/block}
