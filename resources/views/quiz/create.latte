{layout '../layout.latte'}

{block title}ออกข้อสอบจากบทเรียน{/block}

{block content}
<div class="wizard-page" id="quizSetup"
     data-course="{$course['id']}" data-base="{$base}">
    <a class="back-link" href="{$base}/courses/{$course['id']}">← กลับไปที่ {$course['name']}</a>
    <h1>ออกข้อสอบจากบทเรียน</h1>
    <div class="sub">ร่างที่ได้จะยังไม่เผยแพร่ให้นักเรียน จนกว่าครูจะตรวจและยืนยัน</div>

    {if $aiError}
        <div class="alert alert-warning" style="margin-top:18px">
            <span>△</span>
            <div><strong>{$aiError['message']}</strong><br>ยังเปิดหน้านี้เพื่อตั้งค่าไว้ก่อนได้ เมื่อผู้ช่วยกลับมาจะเริ่มร่างได้ทันที</div>
        </div>
    {/if}

    <div class="wizard-grid">
        <div class="card">
            <div class="step-label">1 · เลือกบทเรียนที่ใช้เป็นแหล่งข้อมูล</div>
            {if $lessons}
                <div class="pick-list">
                    {foreach $lessons as $l}
                        <label class="pick-row">
                            <input type="checkbox" name="lessons" value="{$l['id']}" data-title="{$l['title']}">
                            <span class="pick-box">✓</span>
                            <span class="pick-title">{$l['title']}</span>
                            <span class="pick-tag mono">{$l['review_status'] === 'published' ? 'เผยแพร่แล้ว' : 'ร่าง'}</span>
                        </label>
                    {/foreach}
                </div>
            {else}
                <div class="hint">ยังไม่มีบทเรียนในรายวิชานี้ กรุณาเพิ่มบทเรียนก่อน</div>
            {/if}

            <div class="hr"></div>
            <div class="step-label">2 · จำนวนข้อ</div>
            <div class="pill-row" data-group="count">
                {foreach $countOptions as $n}
                    <button type="button" data-value="{$n}" n:class="pill, mono, $n === 8 ? is-on">{$n}</button>
                {/foreach}
            </div>

            <div class="hr"></div>
            <div class="step-label">3 · ชนิดข้อสอบ</div>
            <div class="pill-row" data-group="types" data-multi>
                {foreach $typeOptions as $t}
                    <button type="button" data-value="{$t}" n:class="pill, $t === 'ปรนัย' ? is-on">{$t}</button>
                {/foreach}
            </div>

            <div class="hr"></div>
            <div class="step-label">4 · ระดับความยาก</div>
            <div class="level-row" data-group="level">
                {foreach $levels as $key => $desc}
                    <button type="button" data-value="{$key}" n:class="level-card, $key === 'กลาง' ? is-on">
                        <div class="level-name">{$key}</div>
                        <div class="level-desc">{$desc}</div>
                    </button>
                {/foreach}
            </div>
        </div>

        <aside class="card wizard-summary">
            <div class="step-label">สรุปงานที่จะสร้าง</div>
            <dl class="summary-list">
                <div><dt>บทเรียน</dt><dd id="sumLessons">ยังไม่ได้เลือก</dd></div>
                <div><dt>จำนวนข้อ</dt><dd class="mono" id="sumCount">8 ข้อ</dd></div>
                <div><dt>ชนิดข้อ</dt><dd id="sumTypes">ปรนัย</dd></div>
                <div><dt>ความยาก</dt><dd id="sumLevel">กลาง</dd></div>
            </dl>
            <div class="hr"></div>
            <div class="ai-chip">{$aiChip}</div>
            <div class="hint" style="margin-top:10px">{$aiWait}</div>
            <button type="button" class="btn btn-primary btn-block" id="startBtn" style="margin-top:16px" n:attr="disabled: !$lessons">
                เริ่มสร้างร่างข้อสอบ
            </button>
            <a class="btn btn-block" href="{$base}/settings/ai" style="margin-top:8px">อยากได้เร็วขึ้น? เชื่อม AI ของฉัน</a>
        </aside>
    </div>
</div>

<script>
(function () {
    var root = document.getElementById('quizSetup');
    var base = root.dataset.base, courseId = root.dataset.course;
    var state = { count: 8, types: ['ปรนัย'], level: 'กลาง' };

    function selectedLessons() {
        return Array.prototype.slice.call(root.querySelectorAll('input[name=lessons]:checked'));
    }
    function refresh() {
        var ls = selectedLessons().map(function (i) { return i.dataset.title; });
        document.getElementById('sumLessons').textContent = ls.length ? ls.join(', ') : 'ยังไม่ได้เลือก';
        document.getElementById('sumCount').textContent = state.count + ' ข้อ';
        document.getElementById('sumTypes').textContent = state.types.length ? state.types.join(', ') : 'ยังไม่ได้เลือก';
        document.getElementById('sumLevel').textContent = state.level;
        document.getElementById('startBtn').disabled = ls.length === 0 || state.types.length === 0;
    }

    root.querySelectorAll('input[name=lessons]').forEach(function (i) { i.addEventListener('change', refresh); });

    root.querySelectorAll('.pill-row').forEach(function (row) {
        var group = row.dataset.group, multi = row.hasAttribute('data-multi');
        row.querySelectorAll('.pill').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var v = btn.dataset.value;
                if (multi) {
                    btn.classList.toggle('is-on');
                    state[group] = Array.prototype.slice.call(row.querySelectorAll('.pill.is-on')).map(function (b) { return b.dataset.value; });
                } else {
                    row.querySelectorAll('.pill').forEach(function (b) { b.classList.remove('is-on'); });
                    btn.classList.add('is-on');
                    state[group] = group === 'count' ? parseInt(v, 10) : v;
                }
                refresh();
            });
        });
    });

    root.querySelectorAll('.level-card').forEach(function (btn) {
        btn.addEventListener('click', function () {
            root.querySelectorAll('.level-card').forEach(function (b) { b.classList.remove('is-on'); });
            btn.classList.add('is-on');
            state.level = btn.dataset.value;
            refresh();
        });
    });

    document.getElementById('startBtn').addEventListener('click', function () {
        var qs = new URLSearchParams();
        selectedLessons().forEach(function (i) { qs.append('lessons', i.value); });
        state.types.forEach(function (t) { qs.append('types', t); });
        qs.set('count', state.count);
        qs.set('level', state.level);
        window.location = base + '/courses/' + courseId + '/quizzes/workspace?' + qs.toString();
    });

    refresh();
})();
</script>
{/block}
